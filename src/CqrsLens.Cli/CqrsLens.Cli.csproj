<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CqrsLens</RootNamespace>
    <AssemblyName>cqrslens</AssemblyName>

    <!--
      The package targets net8.0 so it can be built with the current LTS SDK,
      but the global tool should run on newer installed runtimes too. Without
      this, a machine with only .NET 9/10 reports that .NET 8 is required.
    -->
    <RollForward>LatestMajor</RollForward>

    <!-- NuGet / dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cqrslens</ToolCommandName>
    <PackageId>CqrsLens</PackageId>
    <Authors>Abdullah Hakim</Authors>
    <Description>See your MediatR codebase: CqrsLens statically scans a .NET solution (no build required) and generates an ARCHITECTURE.md report with Mermaid diagrams of your project graph, CQRS map, layers, and DbContexts.</Description>
    <PackageTags>mediatr;cqrs;clean-architecture;mermaid;dotnet-tool;architecture</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AbdullahHakima/cqrslens</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AbdullahHakima/cqrslens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CqrsLens.Core\CqrsLens.Core.csproj" />
    <ProjectReference Include="..\CqrsLens.Analysis\CqrsLens.Analysis.csproj" />
    <ProjectReference Include="..\CqrsLens.Reporting\CqrsLens.Reporting.csproj" />
  </ItemGroup>

</Project>
