+        var bracket = 0;
+        var brace = 0;
+        for (var i = start; i < limit; i++)
+        {
+            if (!mask.IsCode(i)) continue;
+            switch (code[i])
+            {
+                case '(': paren++; break;
+                case ')': if (paren > 0) paren--; break;
+                case '[': bracket++; break;
+                case ']': if (bracket > 0) bracket--; break;
+                case '{': brace++; break;
+                case '}': if (brace > 0) brace--; break;
+                case ';' when paren == 0 && bracket == 0 && brace == 0:
