+        var braceDepth = 0;
+        for (var i = bodyStart; i < bodyEnd - 1; i++)
+        {
+            if (!mask.IsCode(i)) continue;
+            var ch = code[i];
+            if (ch == '(') parenDepth++;
+            else if (ch == ')') { if (parenDepth > 0) parenDepth--; }
+            else if (ch == '{') braceDepth++;
+            else if (ch == '}') { if (braceDepth > 0) braceDepth--; }
+            else if (ch == '=' && code[i + 1] == '>' && parenDepth == 0 && braceDepth == 0)
+                return i;
+        }
+        return -1;
