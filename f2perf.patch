+    private static int FindMatchingBrace(string code, SourceMask mask, int openBrace, int limit)
+    {
+        var depth = 0;
+        for (var i = openBrace; i < limit; i++)
+        {
+            if (!mask.IsCode(i)) continue;
+            if (code[i] == '{') depth++;
+            else if (code[i] == '}')
+            {
+                depth--;
+                if (depth == 0) return i;
+            }
+        }
+        return -1;
+    }
